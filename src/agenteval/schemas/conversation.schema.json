{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenteval.dev/schemas/conversation.schema.json",
  "title": "AgentEval Conversation",
  "description": "Schema for a conversational AI evaluation conversation.",
  "type": "object",
  "required": ["metadata", "turns"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["conversation_id", "language", "scenario"],
      "properties": {
        "conversation_id": {
          "type": "string",
          "description": "Unique identifier for the conversation."
        },
        "language": {
          "type": "string",
          "enum": ["en", "pt-br", "es"],
          "description": "Language code of the conversation."
        },
        "scenario": {
          "type": "string",
          "description": "Short label describing the conversation scenario."
        },
        "domain": {
          "type": "string",
          "description": "Business domain (e.g. salon, restaurant, ecommerce)."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of conversation creation."
        },
        "agent_id": {
          "type": "string",
          "description": "Optional identifier for the agent being evaluated."
        },
        "evaluator": {
          "type": "string",
          "description": "Who or what created this evaluation record."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Freeform tags for filtering and grouping."
        }
      },
      "additionalProperties": true
    },
    "system_prompt": {
      "type": "string",
      "description": "The system prompt or instructions given to the agent."
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "agent"],
            "description": "Who sent this message."
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Text content of the message."
          },
          "turn_number": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequential turn number."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of this turn."
          },
          "annotations": {
            "type": "object",
            "description": "Optional annotation metadata for this turn.",
            "properties": {
              "expected_intent": {
                "type": "string",
                "description": "What the agent should have understood."
              },
              "expected_action": {
                "type": "string",
                "description": "What the agent should have done."
              },
              "ground_truth": {
                "type": "string",
                "description": "The correct or ideal response."
              },
              "flags": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Flags for issues (e.g. hallucination, wrong_language)."
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "expected_outcome": {
      "type": "object",
      "description": "What the conversation should achieve.",
      "properties": {
        "task_completed": {
          "type": "boolean",
          "description": "Whether the agent completed the user's task."
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary of the expected outcome."
        }
      },
      "additionalProperties": true
    },
    "reference_scores": {
      "type": "object",
      "description": "Optional human-provided reference scores for comparison.",
      "properties": {
        "language_accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
        "context_retention": { "type": "number", "minimum": 0, "maximum": 100 },
        "instruction_following": { "type": "number", "minimum": 0, "maximum": 100 },
        "factual_grounding": { "type": "number", "minimum": 0, "maximum": 100 },
        "hallucination_safety": { "type": "number", "minimum": 0, "maximum": 100 },
        "safety": { "type": "number", "minimum": 0, "maximum": 100 },
        "professional_tone": { "type": "number", "minimum": 0, "maximum": 100 },
        "task_completion": { "type": "number", "minimum": 0, "maximum": 100 },
        "overall_score": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
